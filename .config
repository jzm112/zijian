# =========================================================
# Target System (目标平台: ARM64 Generic / armsr)
# =========================================================
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_Default=y

# =========================================================
# 基础运行库与 C 库兼容支持 (解决缺失 libc/glibc/gcompat 问题)
# =========================================================
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libucontext=y
CONFIG_PACKAGE_libobstack=y

# =========================================================
# 系统常用基础扩展库 (System & CLI Utilities)
# =========================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y

# =========================================================
# 网络与诊断工具 (Networking & Diagnostics)
# =========================================================
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_bind-dig=y

# =========================================================
# 运行环境支持 (Python3 & Go 运行时，非必选但极度推荐)
# =========================================================
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-asyncio=y
CONFIG_PACKAGE_python3-light=y

# =========================================================
# Docker 容器环境 (内置常用容器运行时与网络支持)
# =========================================================
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# =========================================================
# LuCI Web 界面及核心基础组件
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# =========================================================
# 常用 Web 界面插件 (Storage & System)
# =========================================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-aria2=y

# =========================================================
# 文件系统支持 (支持 EXT4, FAT32, NTFS, BTRFS)
# =========================================================
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fuse=y
